---
import { Image } from "astro:assets";

interface Props {
  title: string;
  imageSrc: ImageMetadata;
  imageAlt: string;
  link: string
}

const { title, imageSrc, imageAlt, link } = Astro.props;
---

<div class="card">
    <Image src={imageSrc} alt={imageAlt} width={350} height={350} />
    <h3>{title}</h3>
    <a href={link}>Learn more</a>
</div>

<style>
  .card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 25rem;
  }

  .card a {
    text-decoration: none;
    color: #000000;
  }

  .card a:hover {
    color: #40798c;
  }


</style>