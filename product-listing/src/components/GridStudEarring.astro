---
import { Image } from "astro:assets";


//images
import img1 from '../assets/stud-earrings0.avif'
import img2 from '../assets/stud-earrings1.avif'
import img3 from '../assets/stud-earrings2.avif'
import img4 from '../assets/stud-earrings3.avif'
import img5 from '../assets/stud-earrings4.avif'
---

<div class="grid-media">
    <Image src={img1} alt='Elegant crystal blue stud earrings' width={400} height={400} />
    <Image src={img2} alt='Elegant crystal blue stud earrings' width={400} height={400} />
    <Image src={img3} alt='Elegant crystal blue stud earrings' width={400} height={400} />
    <Image src={img4} alt='Elegant crystal blue stud earrings' width={400} height={400} />
    <Image src={img5} alt='Elegant crystal blue stud earrings' width={400} height={400} />

</div>

<style>
    .grid-media {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px
    }
</style>