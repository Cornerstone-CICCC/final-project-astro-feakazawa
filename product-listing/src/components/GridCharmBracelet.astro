---
import { Image } from "astro:assets";


//images
import img1 from '../assets/charm-bracelet0.avif'
import img2 from '../assets/charm-bracelet1.avif'
import img3 from '../assets/charm-bracelet2.avif'
import img4 from '../assets/charm-bracelet3.avif'
import img5 from '../assets/charm-bracelet4.avif'
import img6 from '../assets/charm-bracelet5.avif'
---

<div class="grid-media">
    <Image src={img1} alt='Customizable charm bracelet with multiple symbolic charms' width={400} height={400} />
    <Image src={img2} alt='Customizable charm bracelet with multiple symbolic charms' width={400} height={400} />
    <Image src={img3} alt='Customizable charm bracelet with multiple symbolic charms' width={400} height={400} />
    <Image src={img4} alt='Customizable charm bracelet with multiple symbolic charms' width={400} height={400} />
    <Image src={img5} alt='Customizable charm bracelet with multiple symbolic charms' width={400} height={400} />
    <Image src={img6} alt='Customizable charm bracelet with multiple symbolic charms' width={400} height={400} />

</div>

<style>
    .grid-media {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
    }
</style>