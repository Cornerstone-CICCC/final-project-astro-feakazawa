---
import BasicLayout from '../layouts/BasicLayout.astro';
import headerImg from '../assets/bg-product.png';
import { Product } from '../models/product';

//import image components
import GridGoldRing from '../components/GridGoldRing.astro';
import GridDiamondRing from '../components/GridDiamondRing.astro';
import GridPearlNecklace from '../components/GridPearlNecklace.astro';
import GridSilverNecklace from '../components/GridSilverNecklace.astro';
import GridGoldBangles from '../components/GridGoldBanglesBracelet.astro';
import GridCharmBracelet from '../components/GridCharmBracelet.astro'
import GridHoopEarring from '../components/GridHoopEarring.astro';
import GridStudEarring from '../components/GridStudEarring.astro';
import GridLuxuryWatch from '../components/GridLuxuryWatch.astro';
import GridMinimalistWatch from '../components/GridMinimalistWatch.astro';


interface Props {
    product: Product
}

const {product} = Astro.props;
const availability = product.inStock ? 'In stock' : 'Sold out'
const availlabilityClass = product.inStock ? 'in-stock' : 'sold-out'

const imageComponents: Record<string, any> = {
  'gold-ring-classic': GridGoldRing,
  'diamond-engagement-ring': GridDiamondRing,
  'silver-chain-necklace': GridSilverNecklace,
  'pearl-necklace-set': GridPearlNecklace,
  'gold-bangle-pair': GridGoldBangles,
  'charm-bracelet': GridCharmBracelet,
  'stud-earrings': GridStudEarring,
  'hoop-earrings-gold': GridHoopEarring,
  'luxury-watch': GridLuxuryWatch,
  'minimalist-watch': GridMinimalistWatch,
};

const SelectedImage = imageComponents[product.slug];
---

<BasicLayout bgImage={headerImg}>
    <div slot="main-content">
        <div class="grid2col marginB5">
            <div class="bg-cream">
                <!-- only show image if SelectedImage has any value -->
                {SelectedImage && <SelectedImage />}
            </div>    
            <div>
                <h2 class="marginT5 font2">{product.title}</h2>
                <p class="margin05 font12">{product.description}</p>
                <p class="margin1 font15">{`CAD ${product.price}`}</p>
                <p class={availlabilityClass}>{availability}</p>

                <button class="btn-bag marginT5">Add to bag</button>
            </div>
        </div>
    </div>
    
</BasicLayout>

<style>
    .grid2col {
        display: grid;
        grid-template-columns: 0.6fr 1fr;
        justify-content: center;
        justify-items: center;
        column-gap: 5rem;
    }

    .grid-item img {
        width: 100%;
        height: auto;
        object-fit: cover;
        border-radius: 8rem;
  }

    .margin05 {
        margin: 0.5rem 0;
    }

    .margin1 {
        margin: 1rem 0 0
    }

    .marginT5 {
        margin-top: 5rem;
    }

    .marginB5 {
        margin-bottom: 5rem;
    }

    .font15 {
        font-size: 1.5rem;
    }

    .font2 {
        font-size: 2rem;
    }

    .font12 {
        font-size: 1.2rem;
    }

    .in-stock {
        color: #028090
    }

    .sold-out {
        color: #e9190f;
    }

    .btn-bag {
        background-color: #000000;
        color: #ffffff;
        padding: 0.6rem 1.2rem;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        width: 100%;
        height: 4rem;
        font-size: 1.2rem;
  }

    .btn-bag:hover {
        background-color: #284b63;
    }

    .bg-cream {
        background-color: #eae0d5;
    }
</style>
