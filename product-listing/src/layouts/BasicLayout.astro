---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import '../components/GlobalStyle.astro'
import { getImage } from 'astro:assets';
import bgImage from '../assets/bg-jewel.png';

const optimizedBg = await getImage({ src: bgImage });
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
    <title>Liceria | Homepage</title>
    

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Italianno&family=Manrope:wght@200..800&display=swap" rel="stylesheet">
</head>

<body class="hero">
    <Header />
    <slot />
    <!-- <Footer /> -->

</body>
</html>

<style define:vars={{ bgUrl: `url(${optimizedBg.src})` }}>
  .hero {
    background-image: var(--bgUrl);
    background-size: cover;
    background-position: center;
    width: 100%;
    height: 100vh;
    min-height: 400px;
  }
</style>