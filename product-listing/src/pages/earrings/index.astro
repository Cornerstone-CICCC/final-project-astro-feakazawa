---
import BasicLayout from "../../layouts/BasicLayout.astro";
import CardPrice  from "../../components/CardPrice.astro";
import {ProductCatalog} from '../../models/productCatalog'
import bgEarrings from '../../assets/bg-earring.png'

const catalog = new ProductCatalog()
const targetProducts = catalog.getProductsByCategory('earrings')

---

<BasicLayout title="Luceria | Earrings", bgImage={bgEarrings}>
    <h1>Earrings</h1>
    
    <div slot="main-content">
        <div class="margin-grid">
            <div class="grid2col">
                <p>Bold, eye-catching, and endlessly versatile, our earrings will elevate any look. From classic gold-tone plated and silver-tone plated pieces to statement designs, they're ready to style your way for any occasion.</p>
            </div>
        </div>

        <div class="flex">
            {targetProducts.map((product) => (
                <CardPrice 
                    link={`/${product.category}/${product.slug}`}
                    imageSrc={product.image}
                    imageAlt={product.title}
                    title={product.title}
                    description={product.description}
                    price={`CAD ${product.price}`}
                />
            
            ))}
        </div>
    </div>
</BasicLayout>

<style>
    .margin-grid {
        margin: 5rem 10rem
    }

    .grid2col {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
    }

    .grid2col p {
        font-size: 1.5rem;
    }

    .flex {
        display: flex;
        justify-content: space-evenly;
        align-items: center;
    }
</style>